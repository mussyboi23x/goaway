  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }

    main {
      padding: 20px;
      text-align: center;
    }

    #all-games {
      padding-top: 0;
    }

    .game-grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 20px;
      justify-content: center;
    }

    .game-tile {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: center;
      background-color: #fff;
      border-radius: 10px;
    }

    .game-icon {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 5px;
    }

    .game-title {
      margin-top: 10px;
      font-size: 16px;
    }

    .nav-container {
      display: flex;
      justify-content: center;
    }

    .search-container {
      position: relative;
      display: inline-block;
      margin-top: 20px;
    }

    .search-box {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      width: 300px;
      font-size: 16px;
    }

    .search-results {
      display: none;
      position: absolute;
      background-color: #fff;
      border: 1px solid #ccc;
      border-radius: 5px;
      width: 300px;
      top: 40px;
      left: 0;
      z-index: 1;
    }

    .search-results a {
      display: block;
      padding: 10px;
      text-decoration: none;
      color: #333;
      text-align: left;
    }

    .search-results a:hover {
      background-color: #f0f0f0;
    }

    .sortbar {
      background-color: #333;
      overflow: hidden;
      margin-top: 20px;
      border-radius: 5px;
    }

    .sortbar a {
      color: #f2f2f2;
      text-align: center;
      padding: 14px 16px;
      text-decoration: none;
      font-size: 17px;
      display: inline-block;
    }

    .sortbar a:hover {
      background-color: #ddd;
      color: black;
    }

    .sortbar a.active {
      background-color: #04AA6D;
      color: white;
    }

    @media screen and (max-width: 600px) {
      .search-box,
      .search-results {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <main>
    <section id="all-games">
      <h1 class="text-center">All Games</h1>
      <p class="text-center">cool gams</p>

      <div class="sortbar">
        <a class="active">Sort by:</a>
        <a href="#all">All</a>
        <a href="#fnaf">FNAF</a>
        <a href="#moto-x3m">Moto X3M</a>
        <a href="#snail-bob">Snail Bob</a>
        <a href="#vex">Vex</a>
      </div>

      <div class="nav-container">
        <div class="search-container">
          <input class="search-box" id="search-box" type="search" onkeyup="searching(this)" onfocus="fun(this)" placeholder="Search for Games" />
          <div class="search-results" id="search-results"></div>
        </div>
      </div>

      <div id="game-container" class="game-grid-container"></div>
    </section>
  </main>

  <script src="JS/clock.js"></script>
  <script src="JS/search.js"></script>
  <script src="storage.js"></script>

  <script>
//

    const gameContainer = document.getElementById("game-container");
    games.forEach(game => {
      const tile = document.createElement("div");
      tile.className = "game-tile";
      tile.innerHTML = `
        <a href="${game.link}">
          <img src="${game.image}" alt="${game.name}" class="game-icon" />
          <div class="game-title">${game.name}</div>
        </a>
      `;
      gameContainer.appendChild(tile);
    });
  </script>
</body>
</html>
